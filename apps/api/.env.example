# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api

# ── Database ───────────────────────────────────────────────────────────────────
# Local dev: use docker-compose postgres
# Production (Railway): copy from Railway Postgres → Variables tab → DATABASE_URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5270/quinela_dev?schema=public"

# ── Auth ───────────────────────────────────────────────────────────────────────
# Production: generate with: openssl rand -base64 48
JWT_SECRET="change_me_for_dev_only_min_16_chars"
JWT_EXPIRES_IN="7d"

# ── CORS ───────────────────────────────────────────────────────────────────────
# Production: set to your Vercel deployment URL (comma-separated if multiple)
# Example: WEB_CORS_ORIGINS=https://quinela.vercel.app,https://www.quinela.com
WEB_CORS_ORIGINS="http://localhost:3000"

# ── Email / Password reset (Resend) ───────────────────────────────────────────
# Get your API key at https://resend.com
# In development: if RESEND_API_KEY is not set, the reset link is logged to console instead.
# In production: set all three variables.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
PASSWORD_RESET_FROM_EMAIL="noreply@tudominio.com"
WEB_APP_URL="https://tuapp.vercel.app"

# ── Production seed (only needed when running seed.prod.ts) ───────────────────
# These are NOT used by the API at runtime — only by the seed script
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_PASSWORD="change_me_strong_password_min_12"
ADMIN_DISPLAY_NAME="Admin"
