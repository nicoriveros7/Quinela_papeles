# ── API connection ─────────────────────────────────────────────────────────────
# Local dev: points to the local NestJS API
# Production (Vercel): set to your Railway API URL
# Example: NEXT_PUBLIC_API_URL=https://quinela-api.up.railway.app/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ── App branding ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=La Polla Mundialista 2026

# ── Feature flags ──────────────────────────────────────────────────────────────
# Set to 'true' to show knockout (eliminatorias) matches in the User App.
# Keep 'false' during group stage to avoid showing unresolved knockout slots.
NEXT_PUBLIC_SHOW_KNOCKOUT=false
