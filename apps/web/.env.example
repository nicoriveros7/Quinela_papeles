# ── API connection ─────────────────────────────────────────────────────────────
# Local dev: points to the local NestJS API
# Production (Vercel): set to your Railway API URL
# Example: NEXT_PUBLIC_API_URL=https://quinela-api.up.railway.app/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ── App branding ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=La Polla Mundialista 2026
