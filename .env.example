# ── Local Docker Postgres ──────────────────────────────────────────────────────
# Used by docker-compose.yml to start the local dev database.
# These do NOT affect production — Railway manages its own Postgres.
NODE_ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quinela_dev
POSTGRES_PORT=5270

DATABASE_URL="postgresql://postgres:postgres@localhost:5270/quinela_dev?schema=public"
